<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/13"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ced.umbrafell.controller.InventarioController"
      stylesheets="@inventario.css"
      styleClass="inventario-root"
      spacing="12"
      prefWidth="560"
      prefHeight="660">

    <children>

        <Label text="Bolsa de Aldric"
               styleClass="inventario-titulo"/>

        <VBox spacing="6">
            <children>
                <Label fx:id="lblNome"
                       text="Jogador:"
                       styleClass="inventario-info"/>

                <Label fx:id="lblVida"
                       text="Vida:"
                       styleClass="inventario-info"/>

                <Label fx:id="lblJoias"
                       text="Joias Sombrias:"
                       styleClass="inventario-joias"/>

                <Label fx:id="lblFase"
                       text="Fase atual:"
                       styleClass="inventario-info"/>
            </children>
        </VBox>

        <ListView fx:id="listaItens"
                  prefWidth="520"
                  prefHeight="330"
                  styleClass="lista-inventario"/>

        <HBox spacing="10" alignment="CENTER">
            <children>
                <Button fx:id="btnUsar"
                        text="Usar poção"
                        onAction="#onUsar"
                        styleClass="botao-inventario"/>

                <Button fx:id="btnEquipar"
                        text="Equipar talismã"
                        onAction="#onEquipar"
                        styleClass="botao-inventario"/>
            </children>
        </HBox>

        <VBox fx:id="painelDetalhe"
              spacing="6"
              visible="false"
              managed="false"
              styleClass="painel-detalhe-inventario">

            <children>
                <Label fx:id="lblDetalheNome"
                       text="Nenhum item selecionado"
                       wrapText="true"
                       styleClass="detalhe-nome"/>

                <Label fx:id="lblDetalheDesc"
                       text=""
                       wrapText="true"
                       styleClass="detalhe-texto"/>

                <Label fx:id="lblDetalheTipo"
                       text=""
                       wrapText="true"
                       styleClass="detalhe-texto"/>
            </children>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <children>
                <Label fx:id="lblTotal"
                       text="Total: 0 item(s)"
                       styleClass="total-inventario"/>

                <Button text="Fechar"
                        onAction="#onFechar"
                        styleClass="botao-fechar"/>
            </children>
        </HBox>

    </children>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
</VBox>