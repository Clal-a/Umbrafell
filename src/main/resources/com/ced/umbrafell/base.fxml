<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ced.umbrafell.controller.BaseController"
            stylesheets="@base.css"
            prefWidth="1100"
            prefHeight="720"
            styleClass="base-root">

    <top>
        <VBox alignment="CENTER" spacing="8" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="10" left="20"/>
            </padding>

            <Label fx:id="lblTitulo"
                   text="Base de Umbrafell"
                   styleClass="titulo-base"/>

            <Label fx:id="lblJogador"
                   text="Jogador:"
                   styleClass="info-topo"/>

            <Label fx:id="lblJoias"
                   text="Jóias Sombrias:"
                   styleClass="info-topo-destaque"/>

            <Label fx:id="lblStatus"
                   text="Status:"
                   wrapText="true"
                   styleClass="info-topo"/>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE"
                 styleClass="tab-pane-gotico"
                 BorderPane.alignment="CENTER">

            <tabs>
                <Tab text="Upgrades permanentes">
                    <ScrollPane fitToWidth="true"
                                fitToHeight="true"
                                styleClass="scroll-base">

                        <VBox alignment="TOP_CENTER"
                              spacing="18"
                              styleClass="conteudo-aba">

                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>

                            <FlowPane fx:id="flowUpgrades"
                                      hgap="16"
                                      vgap="16"
                                      prefWrapLength="960"
                                      alignment="CENTER"/>

                            <VBox alignment="CENTER"
                                  spacing="10"
                                  styleClass="painel-detalhe">

                                <Label fx:id="lblDetalheTitulo"
                                       text="Nenhum upgrade selecionado"
                                       styleClass="detalhe-titulo"/>

                                <Label fx:id="lblDetalheTexto"
                                       text="Selecione um card para ver os detalhes."
                                       wrapText="true"
                                       styleClass="detalhe-texto"/>

                                <Button fx:id="btnComprarUpgrade"
                                        text="Comprar / Melhorar upgrade"
                                        onAction="#onComprarUpgrade"
                                        styleClass="botao-destaque"/>
                            </VBox>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <Tab text="Talismãs">
                    <ScrollPane fitToWidth="true"
                                fitToHeight="true"
                                styleClass="scroll-base">

                        <VBox alignment="TOP_CENTER"
                              spacing="18"
                              styleClass="conteudo-aba">

                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>

                            <FlowPane fx:id="flowTalismas"
                                      hgap="16"
                                      vgap="16"
                                      prefWrapLength="960"
                                      alignment="CENTER"/>

                            <VBox alignment="CENTER"
                                  spacing="10"
                                  styleClass="painel-detalhe">

                                <Label fx:id="lblDetalheTalismaTitulo"
                                       text="Nenhum talismã selecionado"
                                       styleClass="detalhe-titulo"/>

                                <Label fx:id="lblDetalheTalismaTexto"
                                       text="Selecione um card para ver os detalhes."
                                       wrapText="true"
                                       styleClass="detalhe-texto"/>

                                <Button fx:id="btnComprarTalisma"
                                        text="Comprar talismã"
                                        onAction="#onComprarTalisma"
                                        styleClass="botao-destaque"/>
                            </VBox>
                        </VBox>
                    </ScrollPane>
                </Tab>
            </tabs>
        </TabPane>
    </center>

    <bottom>
        <VBox alignment="CENTER"
              spacing="10"
              styleClass="rodape-base"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>

            <Label fx:id="lblMensagem"
                   text="Escolha sua preparação para a próxima fase."
                   wrapText="true"
                   styleClass="mensagem-base"/>

            <Button text="Continuar para próxima fase"
                    onAction="#onContinuar"
                    styleClass="botao-principal"/>
        </VBox>
    </bottom>

</BorderPane>