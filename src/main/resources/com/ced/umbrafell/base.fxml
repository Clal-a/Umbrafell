<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ced.umbrafell.controller.BaseController"
            stylesheets="@base.css"
            prefWidth="1100"
            prefHeight="720"
            styleClass="base-root">

    <top>
        <VBox alignment="CENTER"
              spacing="12"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets top="28" right="20" bottom="8" left="20"/>
            </padding>

            <Label fx:id="lblTitulo"
                   text="Base de Umbrafell"
                   styleClass="titulo-base-delicado"/>

            <!-- Mantidos para o controller não quebrar, mas escondidos visualmente -->
            <Label fx:id="lblJogador"
                   text=""
                   visible="false"
                   managed="false"/>

            <Label fx:id="lblJoias"
                    text="Joias Sombrias:"
                    styleClass="info-topo-destaque"/>

            <Label fx:id="lblStatus"
                   text=""
                   visible="false"
                   managed="false"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="12"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets top="0" right="26" bottom="0" left="26"/>
            </padding>

            <TabPane tabClosingPolicy="UNAVAILABLE"
                     styleClass="tab-pane-gotico-centralizado"
                     maxWidth="1040"
                     prefHeight="540">

                <tabs>
                    <Tab text="Upgrades">
                        <ScrollPane fitToWidth="true"
                                    fitToHeight="true"
                                    pannable="true"
                                    styleClass="scroll-base">

                            <VBox alignment="TOP_CENTER"
                                  spacing="18"
                                  styleClass="conteudo-aba">

                                <padding>
                                    <Insets top="22" right="18" bottom="22" left="18"/>
                                </padding>

                                <FlowPane fx:id="flowUpgrades"
                                            hgap="18"
                                            vgap="18"
                                            prefWrapLength="470"
                                            maxWidth="470"
                                            alignment="TOP_LEFT"/>

                                <!-- Painel antigo escondido. O botão agora deve ir no card pelo controller. -->
                                <VBox alignment="CENTER"
                                      spacing="10"
                                      visible="false"
                                      managed="false"
                                      styleClass="painel-detalhe">

                                    <Label fx:id="lblDetalheTitulo"
                                           text="Nenhum upgrade selecionado"
                                           styleClass="detalhe-titulo"/>

                                    <Label fx:id="lblDetalheTexto"
                                           text="Selecione um card para ver os detalhes."
                                           wrapText="true"
                                           styleClass="detalhe-texto"/>

                                    <Button fx:id="btnComprarUpgrade"
                                            text="Comprar / Melhorar upgrade"
                                            onAction="#onComprarUpgrade"
                                            styleClass="botao-destaque"/>
                                </VBox>
                            </VBox>
                        </ScrollPane>
                    </Tab>

                    <Tab text="Loja">
                        <ScrollPane fitToWidth="true"
                                    fitToHeight="true"
                                    pannable="true"
                                    styleClass="scroll-base">

                            <VBox alignment="TOP_CENTER"
                                  spacing="18"
                                  styleClass="conteudo-aba">

                                <padding>
                                    <Insets top="22" right="18" bottom="22" left="18"/>
                                </padding>

                                <FlowPane fx:id="flowTalismas"
                                            hgap="18"
                                            vgap="18"
                                            prefWrapLength="470"
                                            maxWidth="470"
                                            alignment="TOP_LEFT"/>

                                <!-- Painel antigo escondido. O botão agora deve ir no card pelo controller. -->
                                <VBox alignment="CENTER"
                                      spacing="10"
                                      visible="false"
                                      managed="false"
                                      styleClass="painel-detalhe">

                                    <Label fx:id="lblDetalheTalismaTitulo"
                                           text="Nenhum talismã selecionado"
                                           styleClass="detalhe-titulo"/>

                                    <Label fx:id="lblDetalheTalismaTexto"
                                           text="Selecione um card para ver os detalhes."
                                           wrapText="true"
                                           styleClass="detalhe-texto"/>

                                    <Button fx:id="btnComprarTalisma"
                                            text="Comprar talismã"
                                            onAction="#onComprarTalisma"
                                            styleClass="botao-destaque"/>
                                </VBox>
                            </VBox>
                        </ScrollPane>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT"
              spacing="16"
              styleClass="rodape-base"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets top="12" right="34" bottom="24" left="34"/>
            </padding>

            <Label fx:id="lblMensagem"
                   text="Escolha sua preparação para a próxima fase."
                   wrapText="true"
                   HBox.hgrow="ALWAYS"
                   styleClass="mensagem-base"/>

            <Button text="Continuar para próxima fase"
                    onAction="#onContinuar"
                    styleClass="botao-continuar-base"/>
        </HBox>
    </bottom>

</BorderPane>