<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.ced.umbrafell.controller.RankingController"
           prefWidth="1280"
           prefHeight="720"
           styleClass="tela-menu">

    <VBox alignment="CENTER"
          spacing="18"
          maxWidth="1000"
          styleClass="painel-ranking">

        <padding>
            <Insets top="32" right="40" bottom="32" left="40"/>
        </padding>

        <Label text="Ranking"
               styleClass="titulo-pagina"/>

        <TableView fx:id="tabelaRanking"
                   prefWidth="920"
                   prefHeight="420"
                   styleClass="tabela-ranking">

            <columns>
                <TableColumn fx:id="colPosicao"
                             text="#"
                             prefWidth="60"/>

                <TableColumn fx:id="colJogador"
                             text="Jogador"
                             prefWidth="180"/>

                <TableColumn fx:id="colPontuacao"
                             text="Pontuação"
                             prefWidth="130"/>

                <TableColumn fx:id="colFase"
                             text="Fase"
                             prefWidth="90"/>

                <TableColumn fx:id="colJoias"
                             text="Joias"
                             prefWidth="120"/>

                <TableColumn fx:id="colInimigos"
                             text="Inimigos"
                             prefWidth="120"/>

                <TableColumn fx:id="colResultado"
                             text="Resultado"
                             prefWidth="150"/>
            </columns>
        </TableView>

        <Label fx:id="lblMensagem"
               text=""
               styleClass="mensagem-menu"/>

        <HBox alignment="CENTER"
              spacing="16">

            <Button text="Atualizar"
                    onAction="#onAtualizar"
                    styleClass="botao-menu"/>

            <Button text="Voltar"
                    onAction="#onVoltar"
                    styleClass="botao-menu"/>
            
            <Button text="Exportar"
                    onAction="#onExportarTxt"
                    styleClass="botao-menu"/>
        </HBox>

    </VBox>
</StackPane>