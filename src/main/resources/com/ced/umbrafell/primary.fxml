<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Rectangle?>

<Pane xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/8.0.171"
      fx:controller="com.ced.umbrafell.controller.GameplayController"
      style="-fx-background-color: green;">

   <children>

      <Button text="Inventário"
              layoutX="20"
              layoutY="20"
              onAction="#onAbrirInventario" />

      <Rectangle fx:id="player"
                 stroke="black"
                 strokeWidth="3"
                 translateX="100"
                 translateY="100"/>

      <Rectangle fx:id="dragao"
                 stroke="black"
                 strokeWidth="3"
                 translateX="350"
                 translateY="200"/>

   </children>

   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

</Pane>