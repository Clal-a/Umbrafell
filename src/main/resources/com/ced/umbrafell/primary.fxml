<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Rectangle?>

<Pane fx:id="rootPane"
      prefWidth="1280.0"
      prefHeight="720.0"
      style="-fx-background-color: black;"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ced.umbrafell.controller.GameplayController">

    <children>

        <ImageView fx:id="background1"
                   fitHeight="720.0"
                   fitWidth="1280.0"
                   pickOnBounds="true"
                   preserveRatio="false">
            <image>
                <Image url="@Background1.png" />
            </image>
        </ImageView>

        <ImageView fx:id="ponteImg"
                   fitHeight="130.0"
                   fitWidth="1280.0"
                   pickOnBounds="true"
                   preserveRatio="false"
                   visible="false"
                   managed="false"
        >
            <image>
                <Image url="@ponte_sem_fundo.png" />
            </image>
        </ImageView>

        <Rectangle fx:id="ponteHitbox"
                   x="0.0"
                   y="300.0"
                   width="1280.0"
                   height="12.0"
                   fill="RED"
                   stroke="RED"
                   opacity="0.0" />

        <Rectangle fx:id="dragao"
                   fill="RED"
                   stroke="RED"
                   strokeWidth="3"
                   width="100.0"
                   height="100.0"
                   translateX="700.0"
                   translateY="200.0" />

        <Rectangle fx:id="morcego"
                   fill="RED"
                   stroke="RED"
                   strokeWidth="3"
                   width="100.0"
                   height="100.0"
                   translateX="500.0"
                   translateY="100.0" />
        
        <Rectangle fx:id="vampiro"
           width="100.0"
           height="150.0"
           translateX="1200.0"
           translateY="300.0"
           fill="RED"
           stroke="RED"
            />
        
        <Rectangle fx:id="sacerdote"
           width="100.0"
           height="150.0"
           translateX="1300.0"
           translateY="300.0"
           fill="RED"
           stroke="RED"
            />
        
        <Rectangle fx:id="quimera"
           width="100.0"
           height="150.0"
           translateX="120.0"
           translateY="300.0"
           fill="RED"
           stroke="RED"
            />

        <Rectangle fx:id="jogador"
                   fill="WHITE"
                   stroke="RED"
                   strokeWidth="3"
                   width="100.0"
                   height="150.0"
                   translateX="120.0"
                   translateY="193.0" />

    </children>

</Pane>
