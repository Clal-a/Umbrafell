<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Rectangle?>

<Pane fx:id="rootPane"
      prefWidth="1280.0"
      prefHeight="720.0"
      minWidth="1280.0"
      minHeight="720.0"
      maxWidth="1280.0"
      maxHeight="720.0"
      style="-fx-background-color: black;"
      xmlns="http://javafx.com/javafx/13"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ced.umbrafell.controller.GameplayController">

    <children>

        <ImageView fx:id="background1"
                   fitHeight="720.0"
                   fitWidth="1280.0"
                   pickOnBounds="true"
                   preserveRatio="false">
            <image>
                <Image url="@Background1.png" />
            </image>
        </ImageView>

        <ImageView fx:id="ponteImg"
                   fitHeight="130.0"
                   fitWidth="1280.0"
                   pickOnBounds="true"
                   preserveRatio="false"
                   visible="false"
                   managed="false"
        >
            <image>
                <Image url="@ponte_sem_fundo.png" />
            </image>
        </ImageView>

        <Rectangle fx:id="ponteHitbox"
                    x="0.0"
                    y="585.0"
                    width="1280.0"
                    height="2.0"
                    fill="RED"
                    opacity="0.0" />

        <Rectangle fx:id="dragao"
                   strokeWidth="3"
                   width="100.0"
                   height="100.0"
                   translateX="700.0"
                   translateY="200.0" />

        <Rectangle fx:id="morcego"
                   strokeWidth="3"
                   width="100.0"
                   height="100.0"
                   translateX="500.0"
                   translateY="100.0" />
        
        <Rectangle fx:id="vampiro"
           width="100.0"
           height="150.0"
           translateX="1200.0"
           translateY="300.0"
            />
        
        <Rectangle fx:id="sacerdote"
           width="100.0"
           height="150.0"
           translateX="1300.0"
           translateY="300.0"
            />
        
        <Rectangle fx:id="quimera"
           width="100.0"
           height="150.0"
           translateX="120.0"
           translateY="300.0"
            />

        <Rectangle fx:id="jogador"
                   strokeWidth="3"
                   width="100.0"
                   height="150.0"
                   translateX="120.0"
                   translateY="193.0" />
        
        <Rectangle fx:id="vidaBackground"
           x="20.0"
           y="20.0"
           width="200.0"
           height="20.0"
           fill="GRAY"
           stroke="BLACK"
           strokeWidth="2"/>

        <Rectangle fx:id="vidaBar"
                   x="20.0"
                   y="20.0"
                   width="200.0"
                   height="20.0"
                   fill="GREEN"
                   stroke="BLACK"
                   strokeWidth="2"/>

    </children>

</Pane>
