<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.ced.umbrafell.controller.CreditosController"
           prefWidth="1280"
           prefHeight="720"
           styleClass="tela-menu">

    <VBox alignment="CENTER"
          spacing="16"
          maxWidth="640"
          styleClass="painel-menu">

        <padding>
            <Insets top="36" right="48" bottom="36" left="48"/>
        </padding>

        <Label text="Créditos"
               styleClass="titulo-pagina"/>

        <Label text="Umbrafell"
               styleClass="subtitulo"/>

        <Label text="Desenvolvido por:"
               styleClass="texto-secundario"/>

        <Label text="Cesar e Danilo"
               styleClass="texto-destaque"/>
        
        <Label text="Disciplina"
               styleClass="subtitulo"/>

        <Label text="Tópicos de Linguagem de Programação II"
               wrapText="true"
               styleClass="texto-secundario"/>

        <Label text="Tecnologias utilizadas"
               styleClass="subtitulo"/>

        <Label text="Java • JavaFX • FXML • PostgreSQL • JDBC • Maven • Scene Builder"
               wrapText="true"
               styleClass="texto-secundario"/>

        <Label text="Jogo de ação gótico inspirado em Castlevania, com progressão de fases, inventário, upgrades, ranking e persistência em banco de dados."
               wrapText="true"
               styleClass="texto-secundario"/>

        <Button text="Voltar"
                onAction="#onVoltar"
                maxWidth="240"
                styleClass="botao-menu"/>

    </VBox>
</StackPane>